# Copy to .env and fill in. Never commit .env.
COOKIDOO_EMAIL=you@example.com
COOKIDOO_PASSWORD=change-me

# Cookidoo site. au/en-AU is cookidoo.com.au.
COOKIDOO_COUNTRY=au
COOKIDOO_LANGUAGE=en-AU

# Optional: require this value in an X-API-Key header on /api requests.
# THERMOHUB_API_KEY=

# Optional: user/group that owns the files in /data (Unraid: 99/100).
# PUID=99
# PGID=100
