# Copy to .env and fill in what you need. Never commit .env.
#
# Nothing is required: open http://<host>:8000/ and connect Cookidoo from the
# Settings page. The settings below are optional.

# Sign in to Cookidoo automatically with these (until you sign out on the page).
# COOKIDOO_EMAIL=you@example.com
# COOKIDOO_PASSWORD=change-me

# Default Cookidoo site until one is picked on the Settings page. au/en-AU is cookidoo.com.au.
# COOKIDOO_COUNTRY=au
# COOKIDOO_LANGUAGE=en-AU

# Require this access key to use the page (asked once per browser).
# THERMOHUB_API_KEY=

# User/group that owns the files in /data (Unraid: 99/100).
# PUID=99
# PGID=100
