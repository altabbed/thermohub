<?xml version="1.0"?>
<Container version="2">
  <Name>thermohub</Name>
  <Repository>ghcr.io/altabbed/thermohub:latest</Repository>
  <Registry>https://github.com/altabbed/thermohub/pkgs/container/thermohub</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/altabbed/thermohub/issues</Support>
  <Project>https://github.com/altabbed/thermohub</Project>
  <Overview>Connects to Cookidoo and serves your Thermomix shopping list as a merged list of things to buy, as a web page and a small HTTP API.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/altabbed/thermohub/main/unraid/thermohub.xml</TemplateURL>
  <Config Name="WebUI / API port" Target="8000" Default="8000" Mode="tcp" Description="Port the web page and API are served on. Change the host side if 8000 is taken." Type="Port" Display="always" Required="true" Mask="false">8000</Config>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/thermohub" Mode="rw" Description="Stores the Cookidoo login tokens so restarts don't need a fresh login." Type="Path" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/thermohub</Config>
  <Config Name="Cookidoo email" Target="COOKIDOO_EMAIL" Default="" Mode="" Description="Email you sign in to Cookidoo with." Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Cookidoo password" Target="COOKIDOO_PASSWORD" Default="" Mode="" Description="Your Cookidoo password." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="API key" Target="THERMOHUB_API_KEY" Default="" Mode="" Description="Optional. When set, API requests must send it in an X-API-Key header." Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Cookidoo country" Target="COOKIDOO_COUNTRY" Default="au" Mode="" Description="Cookidoo site country code (au = cookidoo.com.au)." Type="Variable" Display="advanced" Required="true" Mask="false">au</Config>
  <Config Name="Cookidoo language" Target="COOKIDOO_LANGUAGE" Default="en-AU" Mode="" Description="Cookidoo site language." Type="Variable" Display="advanced" Required="true" Mask="false">en-AU</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User id that owns the appdata files (99 = nobody)." Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group id that owns the appdata files (100 = users)." Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
</Container>
